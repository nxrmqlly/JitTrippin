{
    "name": "Artifact Roundtrip Test",
    "description": "Verifies CopyOut -> Store -> CopyIn end-to-end",
    "jobs": [
        {
            "name": "compile",
            "image": "alpine:latest",
            "steps": [
                {
                    "name": "build",
                    "cmd": "mkdir -p dist && echo 'binary-content' > dist/app.bin && echo '[compile] built dist/app.bin'"
                }
            ],
            "artifacts": [
                {
                    "name": "app-binary",
                    "path": "dist/app.bin"
                }
            ]
        },
        {
            "name": "unit-test",
            "image": "alpine:latest",
            "steps": [
                {
                    "name": "report",
                    "cmd": "mkdir -p reports && echo 'all tests passed' > reports/test-results.txt && echo '[unit-test] wrote reports/test-results.txt'"
                }
            ],
            "artifacts": [
                {
                    "name": "test-report",
                    "path": "reports/test-results.txt"
                }
            ]
        },
        {
            "name": "package",
            "image": "alpine:latest",
            "depends_on": [
                {
                    "job": "compile",
                    "requires": [
                        "app-binary"
                    ]
                },
                {
                    "job": "unit-test",
                    "requires": [
                        "test-report"
                    ]
                }
            ],
            "steps": [
                {
                    "name": "verify-inputs",
                    "cmd": "test -f dist/app.bin && test -f reports/test-results.txt && echo '[package] restored artifacts:' && cat dist/app.bin && cat reports/test-results.txt"
                },
                {
                    "name": "package",
                    "cmd": "mkdir -p release && cat dist/app.bin reports/test-results.txt > release/bundle.txt && echo '[package] created release/bundle.txt'"
                }
            ],
            "artifacts": [
                {
                    "name": "release-bundle",
                    "path": "release/bundle.txt"
                }
            ]
        },
        {
            "name": "deploy",
            "image": "alpine:latest",
            "depends_on": [
                {
                    "job": "package",
                    "requires": [
                        "release-bundle"
                    ]
                }
            ],
            "steps": [
                {
                    "name": "verify-release",
                    "cmd": "test -f release/bundle.txt && echo '[deploy] bundle contents:' && cat release/bundle.txt"
                }
            ]
        }
    ]
}